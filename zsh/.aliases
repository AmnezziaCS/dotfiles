# Dotfiles utils
alias dotfiles="cd ~/workspace/dotfiles"
alias readme="cd ~/workspace/AmnezziaCS"
alias source.zsh="source ~/.zshrc"

# Copy and paste
alias pbcopy='xsel --clipboard --input'
alias pbpaste='xsel --clipboard --output'

# eza
alias ll="eza --all --long --header --git"
alias lt="eza -aT --color=always --group-directories-first --ignore-glob=\"**/node_modules|**/dist|**/.next\""

# fzf
alias f="fzf --preview 'bat --style=numbers --theme=ansi --color=always --line-range :500 {}' | pbcopy | echo `pbpaste`"

# lazygit
alias lg="lazygit"

# Npm scripts
alias nrw="npm run watch"
alias nrs="npm run start"
alias nrd="npm run dev"
alias nrb="npm run build"
alias jest="npm run jest"
alias jestu="npm run jest -- -u"

# Docker
alias dcu="docker compose up"

# Git
alias forceamend="git commit --amend -n && git push --force"